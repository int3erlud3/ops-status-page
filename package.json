{
  "name": "ops-status-page",
  "version": "1.0.0",
  "description": "Static, CSP-locked dashboard for server-healthcheck and cert-expiry-checker JSON",
  "license": "MIT",
  "author": "Alii",
  "type": "module",
  "private": true,
  "bin": {
    "ops-status-page": "bin/ops-status-page.js"
  },
  "files": [
    "bin",
    "public",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "audit": "npm audit --audit-level=low",
    "validate:samples": "node bin/ops-status-page.js validate --no-banner public/data/healthcheck.sample.json public/data/certs.sample.json",
    "serve": "node bin/ops-status-page.js serve"
  },
  "keywords": [
    "dashboard",
    "monitoring",
    "csp",
    "ssl-certificates",
    "healthcheck"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "globals": "17.13.0",
    "linkedom": "0.18.13"
  }
}
